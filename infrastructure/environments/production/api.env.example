RDC_ENV=production
RDC_DEPLOYMENT_ID=production-example
RDC_DATABASE_URL=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_REDIS_URL=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_S3_ENDPOINT=https://production-object-storage.internal.example
RDC_S3_PUBLIC_ENDPOINT=https://objects.example.com
RDC_S3_BUCKET=rdc-production-example
RDC_S3_ACCESS_KEY=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_S3_SECRET_KEY=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_ALLOWED_ORIGINS=["https://app.example.com"]
RDC_SESSION_COOKIE_SECURE=true
RDC_SESSION_TOKEN_PEPPER=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_CSRF_TOKEN_PEPPER=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_API_KEY_PEPPER=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_API_KEY_ISSUANCE_SECRET=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_RATE_LIMIT_KEY=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_CURSOR_SIGNING_KEY=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_PROJECT_SECRET_MASTER_KEY_B64=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_PROJECT_SECRET_MASTER_KEY_VERSION=production-example-v1
RDC_WORKER_BOOTSTRAP_TOKEN=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_WORKER_TOKEN_PEPPER=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_LEASE_TOKEN_PEPPER=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_EXECUTION_RECOVERY_SWEEP_ENABLED=true
RDC_SCHEDULE_DISPATCH_ENABLED=true
RDC_SCHEDULE_DISPATCH_INTERVAL_SECONDS=10
RDC_SCHEDULE_DISPATCH_BATCH_SIZE=100
RDC_SANDBOX_CANARY_REQUEST_QUEUE_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_HTTP_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_BROWSER_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_DATASET_ENABLED=false
