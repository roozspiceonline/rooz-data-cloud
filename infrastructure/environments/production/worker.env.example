RDC_INTERNAL_API_BASE_URL=https://api.internal.example
RDC_WORKER_TOKEN=REQUIRED_FROM_PRODUCTION_SECRET_MANAGER
RDC_WORKER_SOFTWARE_VERSION=REQUIRED_IMMUTABLE_RELEASE_ID
RDC_CONTAINERD_ADDRESS=/run/user/1001/containerd/containerd.sock
RDC_BUILDKIT_ADDRESS=unix:///run/user/1001/buildkit/buildkitd.sock
RDC_CONTAINERD_NAMESPACE=rdc-production-sandbox
RDC_SANDBOX_WORKSPACE_ROOT=/var/lib/rdc-sandbox
RDC_WORKER_HEARTBEAT_SECONDS=10
RDC_WORKER_LEASE_RENEW_SECONDS=30
RDC_SANDBOX_CANARY_REQUEST_QUEUE_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_HTTP_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_BROWSER_ENABLED=false
RDC_SANDBOX_CANARY_REQUEST_QUEUE_DATASET_ENABLED=false
