#include <tunables/global>

profile rdc-agent-default flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny /proc/sys/** wklx,
  deny /sys/** wklx,
  deny /dev/mem rwklx,
  deny /dev/kmem rwklx,
  deny /var/run/docker.sock rw,
  deny /run/docker.sock rw,
  deny mount,
  /** r,
  /tmp/** rw,
  /rdc/input/** r,
  /rdc/output/** rw,
}
