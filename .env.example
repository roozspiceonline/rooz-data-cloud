RDC_ENV=development
RDC_API_PORT=8000
RDC_CONSOLE_PORT=3000
RDC_POSTGRES_PORT=5432
RDC_REDIS_PORT=6379
RDC_MINIO_API_PORT=9000
RDC_MINIO_CONSOLE_PORT=9001

POSTGRES_DB=rooz_data_cloud
POSTGRES_USER=rdc_app
POSTGRES_PASSWORD=change-me-for-local-development
RDC_DATABASE_URL=postgresql+asyncpg://rdc_app:change-me-for-local-development@postgres:5432/rooz_data_cloud
RDC_REDIS_URL=redis://redis:6379/0

RDC_S3_ENDPOINT=http://minio:9000
RDC_S3_BUCKET=rdc-local
RDC_S3_ACCESS_KEY=rdc-local-access
RDC_S3_SECRET_KEY=change-me-for-local-development

RDC_ALLOWED_ORIGINS=["http://localhost:3000"]
RDC_SESSION_COOKIE_NAME=rdc_session
RDC_SESSION_COOKIE_SECURE=false
RDC_SESSION_IDLE_MINUTES=30
RDC_SESSION_ABSOLUTE_HOURS=168
RDC_SESSION_TOKEN_PEPPER=change-me-session-token-pepper-at-least-32-characters
RDC_CSRF_TOKEN_PEPPER=change-me-csrf-token-pepper-at-least-32-characters
RDC_API_KEY_PEPPER=change-me-api-key-pepper-at-least-32-characters
RDC_API_KEY_ISSUANCE_SECRET=change-me-api-key-issuance-secret-at-least-32-characters
RDC_RATE_LIMIT_KEY=change-me-rate-limit-key-at-least-32-characters
RDC_CURSOR_SIGNING_KEY=change-me-cursor-signing-key-at-least-32-characters
# Local-development key only. Replace with a managed 32-byte key before staging.
RDC_PROJECT_SECRET_MASTER_KEY_B64=ZGV2ZWxvcG1lbnQtcmRjLXNlY3JldC1rZXktMzJiISE=
RDC_PROJECT_SECRET_MASTER_KEY_VERSION=local-v1
# Internal execution-plane credentials. Replace before any shared deployment.
RDC_WORKER_BOOTSTRAP_TOKEN=change-me-worker-bootstrap-token-at-least-32-characters
RDC_WORKER_TOKEN_PEPPER=change-me-worker-token-pepper-at-least-32-characters
RDC_LEASE_TOKEN_PEPPER=change-me-lease-token-pepper-at-least-32-characters
RDC_WORKER_LEASE_SECONDS=60
RDC_WORKER_LEASE_MAX_SECONDS=300
RDC_WORKER_MAX_ATTEMPTS=5
RDC_WORKER_SECRET_ENVELOPE_SECONDS=60
RDC_RUN_SSE_POLL_INTERVAL_SECONDS=1.0
RDC_RUN_SSE_HEARTBEAT_SECONDS=15.0
RDC_RUN_SSE_MAX_CONNECTIONS=100
RDC_RUN_SSE_REPLAY_LIMIT=500

NEXT_PUBLIC_RDC_API_BASE_URL=http://localhost:8000/api/v1
