{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset-append.schema.json",
  "title": "RDC Dataset Append v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "rdc.dataset-append/v1"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
