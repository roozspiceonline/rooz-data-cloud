{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-fetch-result.schema.json",
  "title": "RDC Web Fetch Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_digest", "results", "budget"],
  "properties": {
    "schema_version": {"const": "rdc.web-fetch-result/v1"},
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "results": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/result"}
    },
    "budget": {"$ref": "#/$defs/budget"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "url", "status", "headers", "body"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "method": {"enum": ["GET", "HEAD"]},
        "url": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^https://"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          },
          "propertyNames": {
            "enum": [
              "content-type",
              "content-length",
              "etag",
              "last-modified",
              "cache-control"
            ]
          }
        },
        "body": {"$ref": "#/$defs/body"}
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "value", "size_bytes", "sha256"],
      "properties": {
        "encoding": {"enum": ["none", "text", "base64"]},
        "value": {"type": ["string", "null"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests_used",
        "bytes_received",
        "max_requests",
        "max_total_bytes"
      ],
      "properties": {
        "requests_used": {"type": "integer", "minimum": 0},
        "bytes_received": {"type": "integer", "minimum": 0},
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 33554432
        }
      }
    }
  }
}
