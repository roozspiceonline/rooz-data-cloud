{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rooz.example/agent/v1/run-event.json",
  "title": "Rooz Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "run_id",
    "sequence",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "event_type": {
      "enum": [
        "run.connected",
        "run.status",
        "run.log",
        "run.metric",
        "run.warning",
        "run.completed",
        "run.failed",
        "run.heartbeat",
        "run.replay_reset"
      ]
    },
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
