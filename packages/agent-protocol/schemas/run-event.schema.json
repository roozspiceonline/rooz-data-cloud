{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rooz.example/agent/v1/run-event.json",
  "title": "Rooz Run Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "timestamp", "runId", "sequence", "payload"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
    "eventType": {
      "enum": [
        "stream.connected",
        "stream.heartbeat",
        "run.status",
        "run.log",
        "run.metric",
        "run.warning",
        "run.completed",
        "run.failed"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "runId": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"}
  }
}
