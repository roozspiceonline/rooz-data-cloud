{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rooz.example/agent/v1/manifest.json",
  "title": "Rooz Agent Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "name",
    "version",
    "runtime",
    "schemas",
    "capabilities",
    "resources"
  ],
  "properties": {
    "protocol": {
      "const": "rooz.agent/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entrypoint"
      ],
      "properties": {
        "kind": {
          "const": "container"
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/relativePath"
        },
        "output": {
          "$ref": "#/$defs/relativePath"
        },
        "dataset": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "browser",
        "dataset",
        "keyValueStore",
        "requestQueue"
      ],
      "properties": {
        "network": {
          "enum": [
            "none",
            "web-egress"
          ]
        },
        "browser": {
          "type": "boolean"
        },
        "dataset": {
          "type": "boolean"
        },
        "keyValueStore": {
          "type": "boolean"
        },
        "requestQueue": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryMb",
        "cpuUnits",
        "timeoutSeconds",
        "maxProcesses",
        "ephemeralDiskMb"
      ],
      "properties": {
        "memoryMb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768
        },
        "cpuUnits": {
          "type": "integer",
          "minimum": 100,
          "maximum": 16000
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "ephemeralDiskMb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 102400
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "secrets": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
