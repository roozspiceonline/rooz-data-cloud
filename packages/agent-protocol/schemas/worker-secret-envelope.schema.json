{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roozdata.cloud/worker-secret-envelope.schema.json",
  "title": "RDC Worker Secret Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "algorithm",
    "ephemeral_public_key_b64",
    "nonce_b64",
    "ciphertext_b64",
    "expires_at",
    "secret_names",
    "environment"
  ],
  "properties": {
    "grant_id": { "type": "string", "format": "uuid" },
    "algorithm": {
      "const": "X25519-HKDF-SHA256-AES-256-GCM"
    },
    "ephemeral_public_key_b64": {
      "type": "string",
      "minLength": 40,
      "maxLength": 48
    },
    "nonce_b64": {
      "type": "string",
      "minLength": 16,
      "maxLength": 24
    },
    "ciphertext_b64": {
      "type": "string",
      "minLength": 24,
      "maxLength": 1048576
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "secret_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      }
    },
    "environment": {
      "enum": ["development", "test", "staging", "production"]
    }
  }
}
