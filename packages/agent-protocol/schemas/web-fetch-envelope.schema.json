{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-fetch-envelope.schema.json",
  "title": "RDC Web Fetch Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": "rdc.web-fetch/v1"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/request"}
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "url"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "method": {"enum": ["GET", "HEAD"]},
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 8192,
          "pattern": "^https://"
        }
      }
    }
  }
}
