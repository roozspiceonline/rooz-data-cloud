{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sandbox-activation.schema.json",
  "title": "RDC Phase 1J Sandbox Activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "agent_version_id",
    "worker_name",
    "attestation_digest",
    "sandbox_policy_digest",
    "constraints_digest",
    "no_secrets",
    "capability_profile",
    "egress_policy_digest",
    "max_concurrency"
  ],
  "properties": {
    "mode": {
      "const": "canary"
    },
    "agent_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "worker_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sandbox_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "constraints_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "no_secrets": {
      "const": true
    },
    "capability_profile": {
      "enum": [
        "offline-minimal",
        "brokered-web-egress"
      ]
    },
    "egress_policy_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_concurrency": {
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capability_profile": {
            "const": "brokered-web-egress"
          }
        }
      },
      "then": {
        "properties": {
          "egress_policy_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability_profile": {
            "const": "offline-minimal"
          }
        }
      },
      "then": {
        "properties": {
          "egress_policy_digest": {
            "const": null
          }
        }
      }
    }
  ]
}
