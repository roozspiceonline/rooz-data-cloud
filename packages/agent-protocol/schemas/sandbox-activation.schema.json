{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sandbox-activation.schema.json",
  "title": "RDC Sandbox Activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "agent_version_id",
    "worker_name",
    "attestation_digest",
    "sandbox_policy_digest",
    "constraints_digest",
    "no_secrets",
    "capability_profile",
    "egress_policy_digest",
    "browser_policy_digest",
    "dataset_write_enabled",
    "key_value_store_enabled",
    "request_queue_enabled",
    "request_queue_http_enabled",
    "request_queue_browser_enabled",
    "request_queue_dataset_enabled",
    "request_queue_key_value_store_enabled",
    "max_concurrency"
  ],
  "properties": {
    "mode": {
      "const": "canary"
    },
    "agent_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "worker_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sandbox_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "constraints_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "no_secrets": {
      "const": true
    },
    "capability_profile": {
      "enum": [
        "offline-minimal",
        "brokered-web-egress",
        "controlled-browser"
      ]
    },
    "egress_policy_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "browser_policy_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_write_enabled": {
      "type": "boolean"
    },
    "key_value_store_enabled": {
      "type": "boolean"
    },
    "request_queue_enabled": {
      "type": "boolean"
    },
    "request_queue_http_enabled": {
      "type": "boolean"
    },
    "request_queue_browser_enabled": {
      "type": "boolean"
    },
    "request_queue_dataset_enabled": {
      "type": "boolean"
    },
    "request_queue_key_value_store_enabled": {
      "type": "boolean"
    },
    "max_concurrency": {
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request_queue_enabled": {
            "const": true
          },
          "dataset_write_enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "request_queue_dataset_enabled": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_queue_dataset_enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "request_queue_enabled": {
            "const": true
          },
          "dataset_write_enabled": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability_profile": {
            "const": "brokered-web-egress"
          }
        }
      },
      "then": {
        "properties": {
          "egress_policy_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "browser_policy_digest": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_queue_http_enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "request_queue_enabled": {
            "const": true
          },
          "request_queue_browser_enabled": {
            "const": false
          },
          "capability_profile": {
            "const": "brokered-web-egress"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_queue_browser_enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "request_queue_enabled": {
            "const": true
          },
          "request_queue_http_enabled": {
            "const": false
          },
          "capability_profile": {
            "const": "controlled-browser"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability_profile": {
            "const": "controlled-browser"
          }
        }
      },
      "then": {
        "properties": {
          "egress_policy_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "browser_policy_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capability_profile": {
            "const": "offline-minimal"
          }
        }
      },
      "then": {
        "properties": {
          "egress_policy_digest": {
            "const": null
          },
          "browser_policy_digest": {
            "const": null
          }
        }
      }
    }
  ]
}
