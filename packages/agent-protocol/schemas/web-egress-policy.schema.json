{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roozspice.online/schemas/rdc-egress-v1.json",
  "title": "RDC brokered web-egress policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "allowed_schemes",
    "allowed_methods",
    "allowed_hosts",
    "deny_ip_literals",
    "require_global_dns",
    "revalidate_redirects",
    "container_network",
    "max_requests",
    "max_response_bytes",
    "max_total_bytes",
    "max_redirects",
    "connect_timeout_seconds",
    "request_timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "rdc.egress/v1"
    },
    "mode": {
      "const": "brokered"
    },
    "allowed_schemes": {
      "const": ["https"]
    },
    "allowed_methods": {
      "const": ["GET", "HEAD"]
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253
      }
    },
    "deny_ip_literals": {
      "const": true
    },
    "require_global_dns": {
      "const": true
    },
    "revalidate_redirects": {
      "const": true
    },
    "container_network": {
      "const": "none"
    },
    "max_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 8388608
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 33554432
    },
    "max_redirects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "connect_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
