{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.roozdata.cloud/build-execution-result.schema.json",
  "title": "RDC Build Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_kind",
    "outcome",
    "sandbox_attestation_digest",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "rdc.execution-result/v1"
    },
    "work_kind": {
      "const": "BUILD"
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "ABORTED",
        "CANCELLED"
      ]
    },
    "sandbox_attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object"
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "error_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
