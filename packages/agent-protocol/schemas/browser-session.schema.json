{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-session.schema.json",
  "title": "RDC Browser Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "start_url", "wait_until", "actions"],
  "properties": {
    "schema_version": {"const": "rdc.browser/v1"},
    "start_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 8192,
      "pattern": "^https://"
    },
    "wait_until": {"enum": ["domcontentloaded", "load"]},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/snapshot"}
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "include_html"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "type": {"const": "snapshot"},
        "include_html": {"type": "boolean"}
      }
    }
  }
}
