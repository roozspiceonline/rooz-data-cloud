{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-navigation.schema.json",
  "title": "RDC Browser Navigation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "steps"],
  "properties": {
    "schema_version": {"const": "rdc.browser/v2"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/goto"},
          {"$ref": "#/$defs/wait_for_selector"},
          {"$ref": "#/$defs/extract_text"},
          {"$ref": "#/$defs/extract_html"},
          {"$ref": "#/$defs/screenshot"}
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "goto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "url", "wait_until"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "goto"},
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 8192,
          "pattern": "^https://"
        },
        "wait_until": {"enum": ["domcontentloaded", "load"]}
      }
    },
    "wait_for_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "selector", "state", "timeout_ms"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "wait_for_selector"},
        "selector": {"$ref": "#/$defs/selector"},
        "state": {"enum": ["attached", "visible"]},
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 15000
        }
      }
    },
    "extract_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "selector", "max_chars"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "extract_text"},
        "selector": {"$ref": "#/$defs/selector"},
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        }
      }
    },
    "extract_html": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "selector", "max_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "extract_html"},
        "selector": {"$ref": "#/$defs/selector"},
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "full_page"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "screenshot"},
        "full_page": {"const": false}
      }
    }
  }
}
