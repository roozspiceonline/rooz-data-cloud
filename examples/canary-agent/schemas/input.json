{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "values": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "integer",
        "minimum": -1000000,
        "maximum": 1000000
      }
    }
  },
  "required": [
    "message",
    "values"
  ]
}
